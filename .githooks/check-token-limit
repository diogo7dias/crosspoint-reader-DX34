#!/bin/sh
# check-token-limit: block staged files over 5,000 tokens (tokens = bytes / 4).
# Only staged content is measured (git cat-file -s :path), not the working copy.
# Lockfiles, generated code, vendored/build output and binaries are ignored.
# Extra exemptions: list gitignore-style globs in .token-limit-ignore at the repo root.
#
# Usage:
#   .githooks/check-token-limit          check staged files (pre-commit mode)
#   .githooks/check-token-limit --all    check every tracked file (audit mode)
# Override the limit for one run: TOKEN_LIMIT=8000 git commit ...

LIMIT_TOKENS="${TOKEN_LIMIT:-5000}"
LIMIT_BYTES=$((LIMIT_TOKENS * 4))
MODE="${1:-staged}"

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

is_ignored_name() {
  f="$1"
  base=${f##*/}
  case "$base" in
    package-lock.json|npm-shrinkwrap.json|yarn.lock|pnpm-lock.yaml|bun.lockb|bun.lock|\
    Cargo.lock|poetry.lock|uv.lock|Pipfile.lock|pdm.lock|Gemfile.lock|composer.lock|\
    go.sum|go.work.sum|flake.lock|mix.lock|pubspec.lock|Podfile.lock|Package.resolved|\
    packages.lock.json|gradle.lockfile|deno.lock|*.lock|*.lockb)
      return 0 ;;
    *.min.js|*.min.css|*.min.mjs|*.map|*.pb.go|*_pb2.py|*_pb2_grpc.py|*.pb.h|*.pb.cc|\
    *.generated.*|*.gen.*|*_generated.*|*.g.dart|*.freezed.dart|*.snap|*.svg)
      return 0 ;;
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.bmp|*.ico|*.icns|*.tif|*.tiff|*.psd|*.ai|*.heic|*.avif|\
    *.ttf|*.otf|*.woff|*.woff2|*.eot|*.bdf|*.pcf|\
    *.mp3|*.wav|*.ogg|*.flac|*.m4a|*.aac|*.mp4|*.mov|*.webm|*.mkv|*.avi|\
    *.zip|*.tar|*.gz|*.tgz|*.bz2|*.xz|*.7z|*.rar|*.jar|*.apk|*.aab|*.ipa|*.dmg|*.iso|\
    *.bin|*.hex|*.elf|*.uf2|*.img|*.exe|*.dll|*.so|*.dylib|*.a|*.o|*.wasm|*.pyc|\
    *.pdf|*.epub|*.pxc|*.docx|*.xlsx|*.pptx|*.sqlite|*.db|*.pbw|*.blend|*.fbx|*.glb|*.gltf|\
    *.import|*.tres|*.res|*.scn|*.unity|*.asset|*.prefab|*.meta)
      return 0 ;;
  esac
  case "/$f" in
    */node_modules/*|*/.obsidian/*|*/vendor/*|*/dist/*|*/build/*|*/.next/*|*/out/*|*/coverage/*|\
    */target/*|*/__pycache__/*|*/.venv/*|*/third_party/*|*/generated/*|*/__generated__/*)
      return 0 ;;
  esac
  return 1
}

# Match against .token-limit-ignore (gitignore-style globs, one per line, # comments).
is_user_ignored() {
  f="$1"
  [ -f .token-limit-ignore ] || return 1
  while IFS= read -r pat || [ -n "$pat" ]; do
    case "$pat" in ''|'#'*) continue ;; esac
    pat=${pat%/}
    case "$pat" in
      /*) pat=${pat#/}
          case "$f" in $pat|$pat/*) return 0 ;; esac ;;
      */*) case "$f" in $pat|$pat/*) return 0 ;; esac ;;
      *)  base=${f##*/}
          case "$base" in $pat) return 0 ;; esac
          case "/$f/" in */$pat/*) return 0 ;; esac ;;
    esac
  done < .token-limit-ignore
  return 1
}

# Header marker for generated files (first 5 lines of the staged blob).
is_generated_blob() {
  "$@" 2>/dev/null | head -n 5 | grep -Eq '@generated|DO NOT EDIT|Code generated .* DO NOT EDIT|auto-generated|autogenerated'
}

# Binary check: git numstat shows '-' for binary content.
is_binary_staged() {
  git diff --cached --numstat --no-renames -- "$1" 2>/dev/null | grep -q '^-	-	'
}

is_binary_blob() {
  # Fallback: a NUL byte in the first 8 KB means binary.
  n=$("$@" 2>/dev/null | head -c 8000 | wc -c)
  m=$("$@" 2>/dev/null | head -c 8000 | tr -d '\000' | wc -c)
  [ "$n" -ne "$m" ]
}

tmp=$(mktemp 2>/dev/null || echo "/tmp/token-limit.$$")
: > "$tmp"

if [ "$MODE" = "--all" ]; then
  git ls-files -z | tr '\000' '\n'
else
  git diff --cached --name-only --diff-filter=ACMR -z | tr '\000' '\n'
fi | while IFS= read -r f; do
  [ -n "$f" ] || continue
  if [ "$MODE" = "--all" ]; then
    size=$(git cat-file -s "HEAD:$f" 2>/dev/null) || continue
  else
    size=$(git cat-file -s ":$f" 2>/dev/null) || continue
  fi
  [ "$size" -gt "$LIMIT_BYTES" ] || continue
  is_ignored_name "$f" && continue
  is_user_ignored "$f" && continue
  if [ "$MODE" != "--all" ] && is_binary_staged "$f"; then continue; fi
  if [ "$MODE" = "--all" ]; then
    is_binary_blob git cat-file -p "HEAD:$f" && continue
    is_generated_blob git cat-file -p "HEAD:$f" && continue
  else
    is_binary_blob git cat-file -p ":$f" && continue
    is_generated_blob git cat-file -p ":$f" && continue
  fi
  echo "$((size / 4)) $f" >> "$tmp"
done

if [ ! -s "$tmp" ]; then
  rm -f "$tmp"
  exit 0
fi

if [ "$MODE" = "--all" ]; then
  sort -rn "$tmp"
  rm -f "$tmp"
  exit 1
fi

{
  echo ""
  echo "Commit blocked: these staged files are over the $LIMIT_TOKENS token limit (tokens = bytes / 4):"
  echo ""
  sort -rn "$tmp" | while read -r t f; do
    echo "  $f  (~$t tokens)"
  done
  echo ""
  echo "How to split an oversized file:"
  echo "  1. Split by responsibility: move each distinct concern (feature, component, class,"
  echo "     route group) into its own module or file, each under $LIMIT_TOKENS tokens."
  echo "  2. Move shared types, constants and helper functions into their own files"
  echo "     (for example types.ts, constants.py, utils/strings.c) and import them."
  echo "  3. Split large test files by feature or behaviour (one test file per unit under test)."
  echo "  4. Split long docs into linked sections: keep a short index file that links to"
  echo "     one file per topic (for example docs/setup.md, docs/usage.md)."
  echo "  5. Move inline data, fixtures and long string tables into separate data files"
  echo "     (JSON, CSV, YAML) and load them at runtime or in tests."
  echo "  6. Update imports and references, run the tests, then re-stage with git add and commit again."
  echo ""
  echo "If a file is genuinely not agent-authored (generated output, vendored code, data dump),"
  echo "add a glob for it to .token-limit-ignore at the repo root and commit that file."
  echo "Do not bypass this check with --no-verify."
  echo ""
} >&2
rm -f "$tmp"
exit 1
